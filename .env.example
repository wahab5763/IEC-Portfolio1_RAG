# ==============================================================================
# Production RAG Service — Environment Configuration Template
# Copy this file to `.env` and fill in your real credentials.
# NEVER commit `.env` to Git (enforced by `.gitignore`).
# ==============================================================================

# --- Application Metadata ---
APP_NAME=Production RAG Service
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# --- Database (Neon Serverless Postgres + pgvector) ---
# Accepts either Neon's default `postgresql://...` or `postgresql+asyncpg://...`.
# SSL query parameters (`sslmode=require`) are normalized automatically for asyncpg.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-example-host.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_CONNECT_TIMEOUT_SECONDS=15.0

# --- Cohere API (Embeddings & Cross-Encoder Reranking) ---
COHERE_API_KEY=your_cohere_api_key_here
COHERE_EMBED_MODEL=embed-v4.0
# Must stay 1024 to match chunks.embedding vector(1024) in PostgreSQL (API default is 1536)
COHERE_EMBED_DIM=1024
COHERE_RERANK_MODEL=rerank-v5.0-fast

# --- Groq API (Grounded LLM Generation) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.0
GROQ_MAX_TOKENS=1024

# --- External API Resilience (Timeouts & Retries) ---
API_TIMEOUT_SECONDS=30.0
API_MAX_RETRIES=3
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_CONCURRENCY=4

# --- Chunking & Retrieval Parameters (Config B defaults) ---
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_POOL=20
RRF_K=60
# Config A (dense-only) cosine similarity threshold
SIMILARITY_THRESHOLD=0.35
# Config B (hybrid + rerank) calibrated Cohere rerank relevance threshold
RERANK_THRESHOLD=0.25

# --- Guardrails & Input Limits ---
MAX_FILE_SIZE_MB=20
MAX_QUERY_LENGTH=1000
MIN_PDF_CHARS_PER_PAGE=20
RATE_LIMIT_PER_MINUTE=30

# --- Single-Tenant Default User & Phase 2 JWT Auth ---
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000000
JWT_SECRET_KEY=replace_with_a_strong_32_byte_hex_secret_for_phase_2
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Phase 2 Observability (Optional in Phase 1) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
